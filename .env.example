# FarmPrice AI — environment configuration
# Copy this file to .env and adjust values.

# ---- Database -------------------------------------------------------------
# SQLite (default, zero setup). Relative paths are resolved against
# prisma/schema.prisma, i.e. "file:../db/custom.db" = <project>/db/custom.db
DATABASE_URL="file:../db/custom.db"

# MySQL 8 (production) — used by prisma/schema.mysql.prisma
# See database/MYSQL_SETUP.md for the full migration guide.
# MYSQL_URL="mysql://farmprice:YOUR_STRONG_PASSWORD@localhost:3306/farmprice"

# ---- Mini-services ---------------------------------------------------------
# Python interpreter used to launch the Flask ML service.
# Default: /home/z/.venv/bin/python3 (sandbox). Set to your system python.
# PYTHON_BIN=/usr/bin/python3

# Ports are fixed by convention:
#   Next.js app      : 3000
#   Flask ML service : 5001  (pinned automatically, ignores PORT env)
#   Socket.IO        : 3030
